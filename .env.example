# ==============================================================================
# HAJI NUTS & SPICES - MASTER ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copy this file to:
#   - Root directory as `.env` (for local Vite frontend)
#   - `/server` directory as `.env` (for local Express backend)
# And configure corresponding variables in Vercel (Frontend) and Render (Backend).

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Vercel)
# ------------------------------------------------------------------------------
# URL of the backend API (without trailing /api)
# Local: http://localhost:5000
# Production: https://nuts-and-spices-dqzp.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# Cashfree Environment Mode: 'SANDBOX' for testing, 'PRODUCTION' for live payments
VITE_CASHFREE_MODE=SANDBOX

# WhatsApp Customer Support Number (international format without +)
VITE_STORE_WHATSAPP_NUMBER=919876543210

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Express / Render)
# ------------------------------------------------------------------------------
# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# Server HTTP Port
PORT=5000

# Allowed Frontend Origins (Comma-separated URLs for CORS allowlist)
# e.g., http://localhost:5173,https://www.hajinutsandspices.com
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Secret key used for HS256 JWT signing and verification.
# CRITICAL: In production, must be a cryptographically random string >= 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_32_characters_long_for_security

# Optional initial admin user seed password for server/scripts/initDb.js
INITIAL_ADMIN_PASSWORD=AdminStrongPassword123!

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (TiDB Cloud / MySQL)
# ------------------------------------------------------------------------------
# Primary Database Connection URL (SSL required for TiDB Serverless)
DATABASE_URL=mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/nuts_spices?ssl={"rejectUnauthorized":true}

# Alternative granular database variables (used if DATABASE_URL is not set)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=nuts_spices
DB_SSL_CA=

# ------------------------------------------------------------------------------
# 5. CASHFREE PAYMENT GATEWAY (Orders, Sessions & Webhooks)
# ------------------------------------------------------------------------------
# Mode: 'SANDBOX' for testing, 'PRODUCTION' for live
CASHFREE_ENV=SANDBOX

# Cashfree API Credentials (from Cashfree Merchant Dashboard)
CASHFREE_APP_ID=TEST_APP_ID_PLACEHOLDER
CASHFREE_SECRET_KEY=TEST_SECRET_KEY_PLACEHOLDER

# Cashfree Webhook Secret Key (used to verify HMAC-SHA256 signatures on /api/payment/webhook)
CASHFREE_WEBHOOK_SECRET=TEST_WEBHOOK_SECRET_KEY_PLACEHOLDER

# ------------------------------------------------------------------------------
# 6. CLOUDINARY MEDIA UPLOADS (Admin Product / Banner Images)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
